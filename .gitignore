# Root is not (yet) its own git repo — backend/ has its own .git — but
# this is kept ready for when frontend/ lands and/or the root becomes a
# repo. backend/.gitignore carries the equivalent rule today.

# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.env
.env.*
!.env.example

# Editors / OS
.vscode/
.idea/
.DS_Store

# Test / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# Planning / notes / instructions — not published to the repo.
# README.md is the one exception: it's the public-facing doc and stays
# tracked.
*.md
*.txt
!README.md

# Claude Code local runtime state — not project source.
.claude/
