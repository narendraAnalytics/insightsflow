# Copy to .env and fill in real values. Never commit the real .env file.

# --- Core ---
APP_ENV=development
LOG_LEVEL=DEBUG
CORS_ORIGINS=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# --- Database (Neon) ---
# Use a "dev" branch for local work; never point local dev at "production".
# DATABASE_URL: pooled endpoint, used by the running app.
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# DATABASE_URL_DIRECT: unpooled endpoint, used only by Alembic migrations.
DATABASE_URL_DIRECT=postgresql+psycopg://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Phase 1: Clerk (auth) ---
# CLERK_SECRET_KEY=
# CLERK_JWKS_URL=
# CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# CLERK_WEBHOOK_SECRET=   # from Clerk Dashboard -> Webhooks -> Signing Secret

# --- Phase 2: Razorpay (billing) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Phase 3: Integrations ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=
# NOTION_REDIRECT_URI=
# NOTION_VERSION=2026-03-11
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# SLACK_REDIRECT_URI=
# TOKEN_ENCRYPTION_KEYS=v1:base64key
# OAUTH_STATE_SECRET=

# --- Phase 4: Agent / LLM ---
# SARVAM_API_KEY=
# FALLBACK_LLM_API_KEY=

# --- Observability ---
# SENTRY_DSN=
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=insightflow
